# Copy to .env locally. Never commit keys.
# Live SASB calls also need both protocol flags after a dry-run.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Pinned. Any other value is rejected.
SASB_OPENAI_MODEL=gpt-5.6-luna
SASB_ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Keep Luna cheap. Allowed: none, low, medium, high.
SASB_OPENAI_REASONING_EFFORT=none

# Leave unset until the client dry-run is checked.
# SASB_ENABLE_NETWORK=1
# SASB_PROVIDER_VALIDATED=1
